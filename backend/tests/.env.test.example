# =============================================================================
# backend/tests/.env.test.example — plantilla de la configuración de TESTS (se versiona)
# =============================================================================
# Copiá este archivo a `backend/tests/.env.test` (NO se versiona) y completá usuario y
# contraseña de tu PostgreSQL local. Las variables obligatorias no tienen default: si falta
# una, la suite no arranca. La suite corre contra PostgreSQL real (base `foodstore_test`),
# nunca contra la base de desarrollo.
# =============================================================================

# Entorno de ejecución. Para la suite debe ser `test`.
ENVIRONMENT=test

# URL de la base de TESTS (única variable de BD que lee el backend; se usa tal cual).
# El nombre de la base DEBE terminar en `_test`, o la suite aborta.
# Esquema obligatorio: postgresql+psycopg://
# Usuario y contraseña deben coincidir con los de `.env` (raíz); puerto host 5433.
DATABASE_URL=postgresql+psycopg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5433/foodstore_test

# Si es true, el motor imprime cada sentencia SQL. En tests: false.
SQL_ECHO=false

# Clave de firma de JWT. Valor de prueba, NO es un secreto real.
SECRET_KEY=test-only-not-a-secret-CHANGE_ME-0000000000000000000000000000

# Algoritmo de firma de JWT.
ALGORITHM=HS256

# Vida del access token, en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Vida del refresh token, en días.
REFRESH_TOKEN_EXPIRE_DAYS=7

# Nivel de logs: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=WARNING

# Orígenes CORS permitidos, como array JSON de strings (no separados por comas).
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]



# -----------------------------------------------------------------------------
# Integraciones opcionales — opcional: la suite corre sin ellas.
# Los tests que necesitan el camino configurado las inyectan con monkeypatch.
# -----------------------------------------------------------------------------
# Pagos — MercadoPago (opcional: habilita crear pagos).
# MP_ACCESS_TOKEN=
# MP_PUBLIC_KEY=
# MP_NOTIFICATION_URL=
# MP_WEBHOOK_SECRET=
# BACKEND_PUBLIC_URL=
# FRONTEND_URL=
# Imágenes — Cloudinary (opcional: habilita subir imágenes).
# CLOUDINARY_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Segundos posteriores a la rotación en que un refresh viejo se acepta sin considerarlo reuso (>= 0)
REFRESH_REUSE_GRACE_SECONDS=30
# false en tests: el TestClient usa http://testserver, donde una cookie Secure no se reenviaría
REFRESH_COOKIE_SECURE=false
# Atributo SameSite de la cookie del refresh: lax | strict | none (none exige Secure=true)
REFRESH_COOKIE_SAMESITE=lax