# =============================================================================
# backend/.env.example — contrato de configuración del backend (se versiona)
# =============================================================================
# Copiá este archivo a `backend/.env` (NO se versiona) y reemplazá los CHANGE_ME_*.
# Convención:
#   - Las variables OBLIGATORIAS no tienen default: si falta una, la app no arranca
#     y el error la nombra.
#   - Las variables OPCIONALES (bloques «Pagos — MercadoPago (opcional)» e
#     «Imágenes — Cloudinary (opcional)») pueden quedar vacías: la app arranca y la
#     funcionalidad responde con un error específico (503) solo cuando se usa.
#   - Ninguna variable se deriva de otra.
# =============================================================================

# ── Entorno ──────────────────────────────────────────────────────────────────
# Entorno de ejecución: development | production | test.
ENVIRONMENT=development

# ── Base de datos ────────────────────────────────────────────────────────────
# URL de la base (única variable de BD que lee el backend). Se usa tal cual: el backend
# no la construye ni la transforma. Esquema obligatorio: postgresql+psycopg://
# Esta es para correr el backend en tu máquina (localhost:5433). Dentro de docker compose
# el servicio backend recibe su propia DATABASE_URL (host `db`, puerto 5432) desde el compose.
# Usuario, contraseña y base deben coincidir con los de `.env` (raíz).
DATABASE_URL=postgresql+psycopg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5433/foodstore

# Si es true, el motor imprime cada sentencia SQL (útil para depurar; ruidoso).
SQL_ECHO=false

# ── Seguridad / JWT ──────────────────────────────────────────────────────────
# Clave de firma de JWT. Generá una larga y aleatoria (p. ej. `openssl rand -hex 32`).
SECRET_KEY=CHANGE_ME_generar_una_clave_larga_y_aleatoria

# Algoritmo de firma de JWT.
ALGORITHM=HS256

# Vida del access token, en minutos.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Vida del refresh token, en días.
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Logging ──────────────────────────────────────────────────────────────────
# Nivel de logs: DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO



# ── CORS ─────────────────────────────────────────────────────────────────────
# Orígenes permitidos, como array JSON de strings (no separados por comas).
CORS_ORIGINS=["http://localhost:5173"]

# ── Pagos — MercadoPago (opcional) ───────────────────────────────────────────
# Opcional: sin estas variables la app arranca, y crear un pago responde 503.
# Access token de MercadoPago (credencial de la cuenta vendedora).
MP_ACCESS_TOKEN=
# Public key de MercadoPago (la usa el frontend para tokenizar la tarjeta).
MP_PUBLIC_KEY=
# Opcional: URL pública COMPLETA del webhook IPN, p. ej. https://CHANGE_ME.ngrok-free.app/api/v1/pagos/webhook
MP_NOTIFICATION_URL=
MP_WEBHOOK_SECRET=
# Opcional (removible en C-12): base pública del backend para las back_urls del redirect, p. ej. https://CHANGE_ME.ngrok-free.app
BACKEND_PUBLIC_URL=
# Opcional (removible en C-12): URL del frontend a la que redirige el backend tras el pago, p. ej. http://localhost:5173
FRONTEND_URL=

# ── Imágenes — Cloudinary (opcional) ─────────────────────────────────────────
# Opcional: sin estas variables la app arranca, y subir una imagen responde 503.
# Nombre de la nube (cloud name) de Cloudinary.
CLOUDINARY_NAME=
# API key de Cloudinary.
CLOUDINARY_API_KEY=
# API secret de Cloudinary.
CLOUDINARY_API_SECRET=

# Segundos posteriores a la rotación en que un refresh viejo se acepta sin considerarlo reuso (>= 0)
REFRESH_REUSE_GRACE_SECONDS=30
# Atributo Secure de la cookie del refresh (true en producción/HTTPS)
REFRESH_COOKIE_SECURE=true
# Atributo SameSite de la cookie del refresh: lax | strict | none (none exige Secure=true)
REFRESH_COOKIE_SAMESITE=lax