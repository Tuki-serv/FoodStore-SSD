# =============================================================================
# .env.example — variables de docker compose (se versiona)
# =============================================================================
# Copiá este archivo a `.env` (NO se versiona) y reemplazá los CHANGE_ME_*.
# Lo lee SOLO docker compose (docker-compose.yml en la raíz).
# =============================================================================

# ── PostgreSQL (crea el usuario y la base del contenedor) ────────────────────
POSTGRES_USER=CHANGE_ME_USER
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD
POSTGRES_DB=foodstore

# ── pgAdmin (login de la consola web) ────────────────────────────────────────
PGADMIN_EMAIL=CHANGE_ME@example.com
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD